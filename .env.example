# required for agents to actually respond
GROQ_API_KEY=

# optional — used if Groq fails or GROQ_API_KEY is unset
OPENROUTER_API_KEY=
# optional — OpenRouter model slug; defaults to a mapped Groq name
OPENROUTER_MODEL=

# optional — overrides per-agent model, otherwise set in the agents table
SWARM_AGENT_MODEL=llama-3.3-70b-versatile

# optional — Langfuse tracing (Phase 5). Agent works fine with these unset.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
