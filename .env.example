# required for agents to actually respond
# get a key at https://console.groq.com  (env var name is GROQ_API_KEY)
GROQ_API_KEY=

# Groq shut down llama-3.1-8b-instant and llama-3.3-70b-versatile on 2026-08-16
# (free / developer tier). Production replacements:
#   llama-3.1-8b-instant     -> openai/gpt-oss-20b
#   llama-3.3-70b-versatile  -> openai/gpt-oss-120b
#   (preview alternative for the 70B: qwen/qwen3.6-27b)
# https://console.groq.com/docs/deprecations
# optional — overrides every agent's model column
SWARM_AGENT_MODEL=openai/gpt-oss-120b

# optional — used if Groq fails or GROQ_API_KEY is unset
OPENROUTER_API_KEY=
# optional — OpenRouter model slug; defaults to a mapped Groq name
OPENROUTER_MODEL=

# optional — additional OpenAI-compatible providers (see backend/ai_support/providers.py)
HF_TOKEN=
TOGETHER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
FIREWORKS_API_KEY=
PERPLEXITY_API_KEY=
# new providers — any can be connected from Command Center → AI providers or via env here
NVIDIA_API_KEY=
OPENCODE_API_KEY=
ZEN_API_KEY=
# or use ZEN / OpenCode base overrides via provider connect UI
# optional — provider-specific base URL override (kept for parity with self-hosted OpenAI gateways)
# OPENCODE_BASE_URL=https://api.opencode.ai/v1
# ZEN_BASE_URL=https://api.zen.ai/v1
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# optional — Langfuse tracing (Phase 5). Agent works fine with these unset.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# optional — mock agent replies and seed #general with a sample thread (V3.7).
# No GROQ_API_KEY needed when SWARM_DEMO=1.
SWARM_DEMO=0

# optional — encrypts AI provider keys stored via Computer → AI panel
SWARM_SECRET=change-me-in-production

# optional — Composio (Gmail, Slack, GitHub, Notion, 1000+ apps). One key for the workspace.
# https://platform.composio.dev
COMPOSIO_API_KEY=
# optional — shared Composio user_id so every Bot sees the same connected accounts
COMPOSIO_USER_ID=swarm-workspace

# optional — set to 0 to disable Playwright browser-use tools
SWARM_BROWSER=1

# Host-system tools: Bots run/read/write on this machine, bound to SWARM_SYSTEM_ROOT
# (defaults to the swarm repo). Set to 0 to disable. Do not set the root to /
# unless you also set SWARM_SYSTEM_UNRESTRICTED=1.
SWARM_SYSTEM=1
# SWARM_SYSTEM_ROOT=
# SWARM_SYSTEM_UNRESTRICTED=0

# optional — web research / crawl (Computer → Apps). Not LLM providers.
# https://dashboard.exa.ai/api-keys
EXA_API_KEY=
# https://app.tavily.com
TAVILY_API_KEY=
# https://www.firecrawl.dev/app
FIRECRAWL_API_KEY=

# optional — Browser Use CLI (`uv tool install browser-use`) and CUA drivers (`pip install cua-driver`)
# no key required; binaries/SDK must be on the host
# BROWSER_USE_BIN=browser-use

# optional — comma-separated browser origins allowed to call /api (CORS + origin guard)
# SWARM_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
